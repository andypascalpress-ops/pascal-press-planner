# Monday.com API token (from Monday.com → Profile → Developers → API)
MONDAY_API_TOKEN=your_monday_api_token_here

# Monday.com Board IDs
# Pascal Press Marketing Planner board ID (5029546107)
MONDAY_BOARD_ID=
# ETZ Marketing Planner board ID (5029816108)
MONDAY_ETZ_BOARD_ID=
# Excel HSC Copilot Marketing Planner board ID (5029967547)
MONDAY_HSC_BOARD_ID=

# Anthropic API key (from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Microsoft Clarity — ETZ behavioral analytics
# Generate API token at: clarity.microsoft.com → Settings → Data Export → Generate new API token
CLARITY_API_TOKEN=your_clarity_api_token_here
# Override only if the ETZ project ID changes (current: qmef32brd0)
# CLARITY_ETZ_PROJECT_ID=qmef32brd0

# GA4 property for app.exceltestzone.com.au (the ETZ app site — separate from the main site)
# Find it in GA4 → Admin → Property Settings → Property ID
# If unset, the planner falls back to filtering the existing ETZ GA4 property by hostname
# (only works if cross-domain tracking is enabled in that property)
GOOGLE_ANALYTICS_ETZ_APP_PROPERTY_ID=
